# Copier en .env puis adapter :
#   cp .env.example .env
# Les mots de passe marqués « obligatoire » doivent être renseignés.

# Port HTTP exposé sur l'hôte
NIXVM_HTTP_PORT=8080
TZ=Europe/Paris

# SSH root dans le conteneur : ssh -p NIXVM_SSH_PORT root@hôte
# Mot de passe vide = SSH désactivé.
NIXVM_SSH_PORT=2222
NIXVM_ROOT_PASSWORD=

# Accès web (HTTP Basic Auth) — obligatoire en prod
NIXVM_WEB_USER=admin
NIXVM_WEB_PASSWORD=change-moi

# Base MariaDB
# Par défaut : service "db" du compose (hôte = db).
# Pour une MySQL/MariaDB externe, mettre l'IP/hostname et les identifiants.
NIXVM_DB_HOST=db
NIXVM_DB_PORT=3306
NIXVM_DB_NAME=nixvm
NIXVM_DB_USER=nixvm
NIXVM_DB_PASSWORD=change-moi
# Mot de passe root MariaDB du service db local (obligatoire avec le compose)
NIXVM_DB_ROOT_PASSWORD=change-moi-aussi

# Dossier de l'hôte pour /nix (store Nix). Par défaut : ../data/nix
# À placer sur un disque avec au moins 50 Go libres (évitez le disque système Docker).
# NIXVM_NIX_DIR=/srv/nixvm/nix

# Builds temporaires dans le conteneur (~30 Go libres par build).
# Par défaut : storage/nix-builds
# NIXVM_BUILD_DIR=/var/www/html/storage/nix-builds

# Version de Nix installée au premier démarrage
NIX_VERSION=2.35.2
